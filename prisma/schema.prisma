// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LandingPageSource {
  LIMITED
  INFRASTRUCTURE
}

model Newsletter {
  id          String            @id @default(cuid())
  email       String
  landingPage LandingPageSource
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([email, landingPage])
}

enum QuoteStatus {
  pending
  contacted
  quoted
  accepted
  rejected
  completed
}

model Quote {
  id          String      @id @default(cuid())
  name        String
  company     String?
  phone       String
  email       String?
  location    String?
  start       DateTime?
  end         DateTime?
  description String

  status      QuoteStatus @default(pending)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}


enum InfraLandingPage {
  PAYLOADER
  EXCAVATOR
  GRADER
  BACKHOE_LOADER
  BULLDOZER
}

model InfraPageTraffic {
  id String @id @default(cuid())

  landingPage InfraLandingPage?

  utmSource String?
  utmMedium String?
  utmCampaign String?
  utmTerm String?
  utmContent String?

  referrer String?

  visitorId String?
  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([landingPage])
  @@index([utmSource])
  @@index([utmMedium])
  @@index([utmCampaign])
  @@index([createdAt])
  @@index([landingPage, utmSource])
}